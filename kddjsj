        end
        pcall(pressOnce, x, y)
        task.wait(settings.ClickInterval)
    end
end

local originalPlay = SkillCheck.play
local originalWord = SkillCheck.word

SkillCheck.play = function(skillId, clip, caster, target, seed, ...)
    if settings.AutoClick then
        task.spawn(autoClick)
    end
    if not settings.Enabled then
        return originalPlay(skillId, clip, caster, target, seed, ...)
    end
    local solved, ideal = pcall(solve, skillId, seed, settings.Humanize)
    if not (solved and ideal) then
        return originalPlay(skillId, clip, caster, target, seed, ...)
    end
    local result = Checks.grade(skillId, seed, ideal)
    if settings.ShowResult and result then
        shown = result[1]
    end
    local started = os.clock()
    local ok, presses, grade = pcall(originalPlay, skillId, clip, caster, target, seed, ...)
    shown = nil
    if not ok then
        error(presses, 0)
    end
    if presses == nil then
        return presses, grade
    end
    local missing = ideal[#ideal] - (os.clock() - started)
    if missing > 0 then
        task.wait(missing)
    end
    return ideal, result
end

SkillCheck.word = function(grade, rig)
    if shown ~= nil then
        grade = shown
    end
    return originalWord(grade, rig)
end

