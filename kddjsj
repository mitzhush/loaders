local function visible(inst)
    if not (inst and inst:IsA("GuiObject")) then
        return false
    end
    local screen = inst:FindFirstAncestorOfClass("ScreenGui")
    if not (screen and screen.Enabled) then
        return false
    end
    local node = inst
    while node and node ~= screen do
        if node:IsA("GuiObject") and not node.Visible then
            return false
        end
        node = node.Parent
    end
    return true
end

local function click(inst)
    if not inst then
        return false
    end
    if firesignal then
        pcall(function() firesignal(inst.Activated) end)
        pcall(function() firesignal(inst.MouseButton1Click) end)
        return true
    end
    local ok = pcall(function()
        local center = inst.AbsolutePosition + inst.AbsoluteSize / 2
        local inset = GuiService:GetGuiInset()
        VirtualInputManager:SendMouseButtonEvent(center.X + inset.X, center.Y + inset.Y, 0, true, game, 0)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(center.X + inset.X, center.Y + inset.Y, 0, false, game, 0)
    end)
    return ok
end

local function findButtonByText(root, text)
    for _, inst in ipairs(root:GetDescendants()) do
        if (inst:IsA("TextLabel") or inst:IsA("TextButton")) and string.find(string.lower(inst.Text), text, 1, true) then
            local button = inst:IsA("GuiButton") and inst or inst:FindFirstAncestorWhichIsA("GuiButton")
            if button and visible(button) then
                return button
            end
        end
    end
    return nil
end

local function child(root, ...)
    local node = root
    for _, name in ipairs({ ... }) do
        node = node and node:FindFirstChild(name)
    end
    return node
end

local function hubFrame()
    local gui = player:FindFirstChildOfClass("PlayerGui")
    return child(gui, "Hub", "Hub")
end

local function lobbyStep(now)
    local hub = hubFrame()
    if not hub then
        return nil
    end
    local difficulty = child(hub, "Difficulty", "Window")
    if difficulty then
        local card = difficulty:FindFirstChild("Card" .. (DIFFICULTY_INDEX[settings.Difficulty] or 1))
        local selected = card and card:FindFirstChild("Selected")
        if selected and not selected.Visible then
            click(card:FindFirstChild("Pick"))
            click(card:FindFirstChild("Hit"))
            return "difficulty"
        end
        click(difficulty:FindFirstChild("Go"))
        runState.lastAttempt = now
        runState.goCount = runState.goCount + 1
        return "go"
    end
    local lands = child(hub, "Lands", "Window")
    if lands then
        local card = child(lands, "Row", "Content", "Card" .. (LAND_INDEX[settings.Land] or 1))
        if card then
            click(card:FindFirstChild("Key"))
            click(card:FindFirstChild("Hit"))
        end
        return "lands"
    end
    local travel = child(hub, "Travel", "Window")
    if travel then
        local card = travel:FindFirstChild("Card1")
        if card then
            click(card:FindFirstChild("Key"))
            click(card:FindFirstChild("Hit"))
        end
        return "travel"
    end
    local start = hub:FindFirstChild("StartRun")
    if visible(start) and now - math.max(runState.lastEnd, runState.lastAttempt) >= settings.Delay then
        click(start)
        return "start"
    end
    return nil
end

local function stopAutoStart(reason)
    settings.AutoStart = false
    pcall(function() autoToggle.SetState(false, true) end)
    notify("Auto Start Run turned off: " .. reason)
end

local function tick()
    local now = os.clock()
    local gui = player:FindFirstChildOfClass("PlayerGui")
    if settings.AutoContinue and gui and now - runState.lastContinue > 3 and Fight.over() then
        local win = gui:FindFirstChild("Win", true)
        local button = win and visible(win) and findButtonByText(win, "continue")
        if button then
            runState.lastContinue = now
            task.wait(0.6 + math.random() * 0.8)
            click(button)
            return
        end
    end
    if (settings.AutoAgain or settings.FirstCamp == "home") and gui and now - runState.lastAgain > 4 then
        local again = gui:FindFirstChild("Again", true)
        if visible(again) then
            local allowed = settings.AutoAgain
            if runState.endKind == "first" then
                allowed = settings.FirstCamp == "home"
            end
            if allowed then
                runState.lastAgain = now
                task.wait(0.6 + math.random() * 0.8)
                click(again)
                return
            end
        end
    end
    if not settings.AutoStart or runState.inRun then
        runState.step = nil
        runState.stepCount = 0
        return
    end
    local step = lobbyStep(now)
    if step == nil then
        runState.step = nil
        runState.stepCount = 0
        return
    end
    if step == runState.step then
        runState.stepCount = runState.stepCount + 1
    else
        runState.step = step
        runState.stepCount = 1
    end
    if runState.goCount >= 3 then
        stopAutoStart("the server did not start the run after 3 attempts")
    elseif runState.stepCount > 8 then
        stopAutoStart("got stuck at step " .. step .. " (map locked or click had no effect)")
    end
end

local function applySnap(snap)
    if type(snap) ~= "table" or type(snap.fighters) ~= "table" then
        return
    end
    for _, fighter in pairs(snap.fighters) do
        fightState.hp[fighter.id] = fighter.hp
        fightState.down[fighter.id] = fighter.down
    end
end

local function pickTarget()
    local best
    local bestHp
    for id, side in pairs(fightState.sides) do
        local hp = fightState.hp[id]
        if side == "enemy" and hp and hp > 0 and not fightState.down[id] then
            local better = bestHp == nil
            if not better then
                if settings.TargetMode == "least" then
                    better = hp < bestHp
                else
                    better = hp > bestHp
                end
            end
            if better then
                best = id
                bestHp = hp
            end
        end
    end
    return best
end

local function pickAlly()
    local best
    local bestHp
    for id, side in pairs(fightState.sides) do
        local hp = fightState.hp[id]
        if side == "party" and hp and not fightState.down[id] then
            if bestHp == nil or hp < bestHp then
                best = id
                bestHp = hp
            end
        end
    end
    return best
end

local function livingParty()
    local list = {}
    for id, side in pairs(fightState.sides) do
        if side == "party" and not fightState.down[id] then
            table.insert(list, id)
        end
    end
    table.sort(list)
    return list
end

local function useSkill(prompt, entry, def)
    local reach = entry.reach or def.target
    local target = nil
    if not Fighter.noTarget(def, reach) then
        if reach == "ally" then
            target = pickAlly()
        else
            target = pickTarget()
        end
        if not target then
            return false
        end
    end
    local skipShot = reach == "allies" or reach == "self" or (reach == "enemies" and not def.hit)
    if not skipShot and def.cast == true then
        skipShot = not def.hit
    end
    local shotTarget = nil
    if not skipShot then
        shotTarget = target
    end
    local presses = nil
    if prompt.seed and Checks.list[def.id] then
        local played, result = pcall(SkillCheck.play, def.id, def.anim, prompt.actor or fightState.you, shotTarget, prompt.seed, livingParty(), target)
        if not played then
            return false
        end
        presses = result
    end
    local ok = Ui.request("FightAct", def.id, target, presses, prompt.turn)
    return ok == true
end

local function trySkills(prompt)
    if type(prompt.skills) ~= "table" then
        return false
    end
    for _, label in ipairs(settings.Skills) do
        local wanted = SKILL_BY_LABEL[label]
        if wanted then
            for _, entry in ipairs(prompt.skills) do
                local def = skillDefs[wanted]
                if entry.id == wanted and not entry.why and def then
                    if useSkill(prompt, entry, def) then
                        return true
                    end
                end
            end
        end
    end
    return false
end

local function autoTurn(token, prompt)
    task.wait(1.2 + math.random() * 0.6)
    for _ = 1, 8 do
        if token ~= fightState.token or not alive then
            return
        end
        if settings.AutoSkill and trySkills(prompt) then
            return
        end
        if settings.AutoAttack then
            local target = pickTarget()
            if target then
                pcall(Fight.select)
                pcall(Fight.confirm, target)
            end
        end
        task.wait(0.9)
    end
end

local function pickCard(view)
    local land = string.lower(tostring(view.land or settings.Land))
    local priorities = settings.Scenes[land]
    if priorities then
        for _, wanted in ipairs(priorities) do
            if wanted ~= NONE then
                for index, card in ipairs(view.cards) do
                    if string.lower(tostring(card.title)) == string.lower(wanted) then
                        return index
                    end
                end
            end
        end
    end
    return 1
end

local function pickChoice(event)
    local indexes = {}
    for index, choice in ipairs(event.choices or {}) do
        if not choice.off and not choice.hidden then
            table.insert(indexes, index)
        end
    end
    if #indexes == 0 then
        return nil
    end
    if settings.VoteMode == "last" then
        return indexes[#indexes]
    end
    return indexes[1]
end

local function sigOf(view)
    local screen = tostring(view.screen)
    local step = tostring(view.step)
    if screen == "cards" and type(view.cards) == "table" then
        local titles = {}
        for index, card in ipairs(view.cards) do
            titles[index] = tostring(card.title)
        end
        return "cards|" .. step .. "|" .. table.concat(titles, ",")
    end
    if screen == "event" and type(view.event) == "table" then
        local event = view.event
        return table.concat({ "event", step, tostring(event.title), event.result and "r" or "-", tostring(event.chosen) }, "|")
    end
    if screen == "camp" and type(view.camp) == "table" then
        local camp = view.camp
        return table.concat({ "camp", step, tostring(camp.title), tostring(camp.go), tostring(camp.home) }, "|")
    end
    if screen == "shop" and type(view.shop) == "table" then
        return table.concat({ "shop", step, tostring(view.shop.title) }, "|")
    end
    return screen .. "|" .. step .. "|" .. tostring(view.scene)
end

local function decide(view)
    local screen = view.screen
    if screen == "cards" then
        if settings.AutoScenes and not view.out and type(view.cards) == "table" and #view.cards > 0 then
            return "RunVote", pickCard(view)
        end
    elseif screen == "camp" then
        if settings.AutoCamp and type(view.camp) == "table" then
            local camp = view.camp
            local goHome = true
            if camp.go and not camp.toward then
                goHome = settings.FirstCamp == "home"
            end
            return "RunCamp", goHome
        end
    elseif screen == "event" then
        local event = view.event
        if type(event) == "table" then
            if event.small or event.result then
                if settings.AutoContinue then
                    return "RunReady"
                end
            elseif settings.AutoVote and not view.out then
                local index = pickChoice(event)
                if index then
                    return "RunVote", index
                end
            end
        end
    elseif screen == "shop" then
        if settings.AutoContinue then
            return "RunReady"
        end
    elseif screen == "scene" then
        if settings.SkipCutscenes then
            return "RunReady"
        end
    end
    return nil
end

local function handleView(view)
    if type(view) ~= "table" then
        return
    end
    local sig = sigOf(view)
    if sig == runState.viewSig then
        return
    end
    local name, argument = decide(view)
    if not name then
        return
    end
    runState.viewSig = sig
    task.spawn(function()
        task.wait(0.7 + math.random() * 0.9)
        if not alive or runState.viewSig ~= sig then
            return
        end
        if view.screen == "scene" and Cutscene then
            pcall(Cutscene.skip)
        end
        local ok, result, reason
        if argument == nil then
            ok, result, reason = pcall(Net.Request, Net, name)
        else
            ok, result, reason = pcall(Net.Request, Net, name, argument)
        end
        if not (ok and result) then
            runState.viewSig = nil
            notify(name .. " failed: " .. tostring(ok and reason or result))
        end
    end)
end

local offs = {}

local function listen(name, callback)
    table.insert(offs, Net:On(name, callback))
end

listen("RunView", function(view)
    runState.inRun = true
    runState.goCount = 0
    if type(view) == "table" then
        runState.lastScreen = view.screen
        if view.screen == "camp" and type(view.camp) == "table" then
            runState.lastCampMid = view.camp.go and not view.camp.toward and true or false
        end
    end
    handleView(view)
end)

listen("RunEnd", function()
    runState.inRun = false
    runState.lastEnd = os.clock()
    runState.endKind = (runState.lastScreen == "camp" and runState.lastCampMid) and "first" or "other"
    runState.viewSig = nil
end)

listen("FightBegin", function(list, snap)
    fightState.token = fightState.token + 1
    fightState.you = nil
    fightState.sides = {}
    fightState.hp = {}
    fightState.down = {}
    if type(list) == "table" then
        for _, entry in pairs(list) do
            fightState.sides[entry.id] = entry.side
            if entry.you then
                fightState.you = entry.id
            end
        end
    end
    applySnap(snap)
end)

listen("FightStep", function(_, _, snap, extra)
    applySnap(snap)
    fightState.token = fightState.token + 1
    local prompt = type(extra) == "table" and extra.prompt
    if (settings.AutoAttack or settings.AutoSkill) and type(prompt) == "table" then
        task.spawn(autoTurn, fightState.token, prompt)
    end
end)

listen("FightEnd", function()
    fightState.token = fightState.token + 1
end)

task.spawn(function()
    while alive do
        task.wait(1)
        if alive then
            pcall(tick)
        end
    end
end)

local unloaded = false

local function unload()
    if unloaded then
        return
    end
    unloaded = true
    alive = false
    SkillCheck.play = originalPlay
    SkillCheck.word = originalWord
    for _, off in ipairs(offs) do
        pcall(off)
    end
    env.SkillCheckPerfect = nil
    pcall(function() MitHub:Destroy() end)
end

MitHub.Destroying:Connect(unload)

env.SkillCheckPerfect = { unload = unload }
