local PERFECT = Checks.PERFECT
local STEP = 0.005

local shown = nil

local function allPerfect(grade)
    if type(grade) ~= "table" then
        return false
    end
    local count = 0
    for _, value in pairs(grade) do
        count = count + 1
        if value ~= PERFECT then
            return false
        end
    end
    return count > 0
end

local function scan(id, seed, from, to, build)
    local first, last
    local t = from
    while t <= to do
        if allPerfect(Checks.grade(id, seed, build(t))) then
            first = first or t
            last = t
        elseif first then
            break
        end
        t = t + STEP
    end
    return first, last
end

local function spread(first, last, humanize)
    if humanize then
        return first + (last - first) * (0.25 + 0.5 * math.random())
    end
    return (first + last) / 2
end

local function steadiest(def, seed)
    local bestT = def.tire
    local bestM = math.huge
    local t = 0.07
    while t <= def.tire do
        local x, y = Checks.aim(def, seed, t)
        local m = math.sqrt(x * x + y * y)
        if m < bestM then
            bestT = t
            bestM = m
        end
        t = t + STEP
    end
    return bestT
end

local function build(def, id, seed, humanize)
    local kind = def.kind
    if kind == "thrust" or kind == "cuts" or kind == "strums" then
        local presses = {}
        for i, mark in ipairs(def.marks) do
            local offset = humanize and (math.random() * 2 - 1) * 0.03 or 0
            presses[i] = mark + offset
        end
        return presses
    end
    if kind == "gather" then
        local ratio = spread(def.perfect[1], def.perfect[2], humanize)
        return { 0.2, 0.2 + ratio * def.fill }
    end
    if kind == "rally" then
        local presses = {}
        for i = 1, def.perfect do
            presses[i] = 0.12 + 0.08 * (i - 1)
        end
        return presses
    end
    if kind == "sigil" then
        local presses = {}
        for i = 1, def.count do
            presses[i] = 0.2 * i
        end
        return presses
    end
    if kind == "steady" then
        local first, last = scan(id, seed, 0.07, def.tire, function(t)
            return { 0.2, 0.2 + t }
        end)
        if first then
            return { 0.2, 0.2 + spread(first, last, humanize) }
        end
        return nil
    end
    local first, last = scan(id, seed, Checks.EARLIEST, def.wait, function(t)
        return { t }
    end)
    if first then
        return { spread(first, last, humanize) }
    end
    return nil
end

local function solve(id, seed, humanize)
    local def = Checks.list[id]
    if not def then
        return nil
    end
    local modes = { humanize == true, false }
    for _, mode in ipairs(modes) do
        local presses = build(def, id, seed, mode)
        if presses and allPerfect(Checks.grade(id, seed, presses)) and #Checks.clean(presses) == #presses then
            return presses
        end
    end
    if def.kind == "steady" then
        return { 0.2, 0.2 + steadiest(def, seed) }
    end
    return nil
end

local function freeSpot(gui, x, y)
    local ok, objects = pcall(function()
        return gui:GetGuiObjectsAtPosition(x, y)
    end)
    if not ok then
        return true
    end
    for _, object in ipairs(objects) do
        if object.Active or object:IsA("GuiButton") then
            return false
        end
    end
    return true
end

local function clickPoint()
    local gui = player:FindFirstChildOfClass("PlayerGui")
    local size = workspace.CurrentCamera.ViewportSize
    local inset = GuiService:GetGuiInset()
    local spots = {
        { 0.5, 0.5 }, { 0.5, 0.4 }, { 0.5, 0.6 }, { 0.4, 0.5 }, { 0.6, 0.5 },
        { 0.5, 0.3 }, { 0.5, 0.7 }, { 0.3, 0.4 }, { 0.7, 0.4 },
    }
    for _, spot in ipairs(spots) do
        local x = size.X * spot[1]
        local y = size.Y * spot[2]
        if gui and freeSpot(gui, x, y) and freeSpot(gui, x, y - inset.Y) then
            return x, y
        end
    end
    return size.X / 2, size.Y / 2
end

local function pressOnce(x, y)
    if UserInputService.KeyboardEnabled then
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
        task.wait(0.01)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
    end
    if UserInputService.TouchEnabled then
        pcall(function() VirtualInputManager:SendTouchEvent(1, 0, x, y) end)
        pcall(function() VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 0) end)
        task.wait(0.02)
        pcall(function() VirtualInputManager:SendTouchEvent(1, 2, x, y) end)
        pcall(function() VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 0) end)
    end
end

local function autoClick()
    if settings.ClickDelay > 0 then
        task.wait(settings.ClickDelay)
