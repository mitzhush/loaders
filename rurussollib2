local function NormalizeAssetId(raw)
    local s = tostring(raw or ""):gsub("%s", "")
    if s == "" then return nil end
    if s:match("^%d+$") then return "rbxassetid://" .. s end
    local n = s:match("^rbxassetid://(%d+)$")
    if n then return "rbxassetid://" .. n end
    n = s:match("[?&]id=(%d+)")
    if n then return "rbxassetid://" .. n end
    return nil
end

