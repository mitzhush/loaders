end

function MitHubLib:MakeColorRow(parent, labelText, defaultColor, flag, callback)
    local C = self.COLORS
    local current = defaultColor or Color3.fromRGB(255, 255, 255)

    local row = self:MakeRow(parent, 34)
    self:MakeLabel(row, labelText or "Color", 10, 130)

    local hexLbl = Instance.new("TextLabel", row)
    hexLbl.Size = UDim2.new(0, 64, 1, 0)
    hexLbl.Position = UDim2.new(1, -116, 0, 0)
    hexLbl.BackgroundTransparency = 1
    hexLbl.Text = ToHex(current)
    hexLbl.Font = Enum.Font.GothamSemibold
    hexLbl.TextColor3 = C.TEXT_DIM
    hexLbl.TextSize = 10
    hexLbl.TextXAlignment = Enum.TextXAlignment.Right

    local swatch = Instance.new("Frame", row)
    swatch.Size = UDim2.new(0, 34, 0, 18)
    swatch.Position = UDim2.new(1, -44, 0.5, -9)
    swatch.BackgroundColor3 = current
    swatch.BorderSizePixel = 0
    Corner(swatch, 4)
    Stroke(swatch, BLACK, 1.5, 0)

    local hit = Instance.new("TextButton", row)
    hit.Size = UDim2.new(1, 0, 1, 0)
    hit.BackgroundTransparency = 1
    hit.Text = ""
    hit.AutoButtonColor = false

    local api = { Frame = row, Preview = swatch }

    local function apply(c)
        current = c
        swatch.BackgroundColor3 = c
        hexLbl.Text = ToHex(c)
    end

    function api.GetColor() return current end

    function api.SetColor(c, fire)
        apply(c)
        local P = self._picker
        if P and P.owner == api then P.Set(c) end
        if fire and callback then callback(c) end
    end

    function api.Open()
        PlayClickSound()
        local P = self:_GetPicker()
        P.Open(swatch, current, function(c)
            apply(c)
            if callback then callback(c) end
        end, api)
    end

    function api.Close()
        local P = self._picker
        if P and P.owner == api then P.Close() end
    end

    hit.MouseButton1Click:Connect(api.Open)

    if flag ~= false then
        self:RegisterFlag(flag or (parent.Name .. ":" .. (labelText or "Color")),
            function()
                return {
                    math.round(current.R * 255),
                    math.round(current.G * 255),
                    math.round(current.B * 255),
                }
            end,
            function(t)
                if type(t) == "table" then
                    api.SetColor(Color3.fromRGB(t[1] or 255, t[2] or 255, t[3] or 255), true)
                end
            end
        )
    end

    return api
end

function MitHubLib:AddColorPicker(page, text, default, callback, flag)
    return self:MakeColorRow(page, text, default, flag, callback)
end

function MitHubLib:MakeSlider(parent, labelText, minVal, maxVal, default, decimals, callback, flag)
    local C = self.COLORS
    local dec = decimals or 0

    local row = self:MakeRow(parent, 50)
    self:MakeLabel(row, labelText, 10, 120)

    local valLbl = Instance.new("TextLabel", row)
    valLbl.Size = UDim2.new(0, 40, 0, 14)
    valLbl.Position = UDim2.new(1, -48, 0, 6)
    valLbl.BackgroundTransparency = 1
    valLbl.TextColor3 = C.TEXT_DIM
    valLbl.TextSize = 10
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextXAlignment = Enum.TextXAlignment.Right

    local trackBg = Instance.new("Frame", row)
    trackBg.Size = UDim2.new(1, -16, 0, 6)
    trackBg.Position = UDim2.new(0, 8, 1, -14)
    trackBg.BackgroundColor3 = C.THEME_DARK
    trackBg.BorderSizePixel = 0
    Corner(trackBg, 3)
    Stroke(trackBg, "THEME", 1, 0.6)

    local trackFill = Instance.new("Frame", trackBg)
    trackFill.Size = UDim2.new(0, 0, 1, 0)
    trackFill.BackgroundColor3 = C.THEME
    Th(trackFill, "BackgroundColor3", "THEME")
    trackFill.BorderSizePixel = 0
    Corner(trackFill, 3)

    local thumb = Instance.new("Frame", trackBg)
    thumb.Size = UDim2.new(0, 10, 0, 10)
    thumb.AnchorPoint = Vector2.new(0.5, 0.5)
    thumb.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    thumb.BorderSizePixel = 0
    Corner(thumb, 0, 1)

    local currentValue = default or minVal
    local dragging = false

    local function setValue(v)
        v = math.clamp(tonumber(v) or minVal, minVal, maxVal)
        local pct = (v - minVal) / (maxVal - minVal)
        trackFill.Size = UDim2.new(pct, 0, 1, 0)
        thumb.Position = UDim2.new(pct, 0, 0.5, 0)
        currentValue = v
        valLbl.Text = string.format("%." .. dec .. "f", v)
        if callback then callback(v) end
    end

    setValue(currentValue)

    trackBg.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and (
            inp.UserInputType == Enum.UserInputType.MouseMovement
            or inp.UserInputType == Enum.UserInputType.Touch
        ) then
            local absSize = trackBg.AbsoluteSize.X
            local absPos = trackBg.AbsolutePosition.X
            local pct = math.clamp((inp.Position.X - absPos) / absSize, 0, 1)
            local raw = minVal + pct * (maxVal - minVal)
            local step = 10 ^ (-dec)
            setValue(math.floor(raw / step + 0.5) * step)
        end
    end)
    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    self:RegisterFlag(flag or (parent.Name .. ":" .. labelText),
        function() return currentValue end,
        setValue
    )

    return {
        Frame = row,
        GetValue = function() return currentValue end,
        SetValue = setValue,
    }
end

function MitHubLib:AddValueBox(page, text, default, callback, flag, minVal, maxVal, decimals)
    local C = self.COLORS
    minVal = tonumber(minVal)
    maxVal = tonumber(maxVal)
    decimals = tonumber(decimals)
    if decimals then decimals = math.clamp(math.floor(decimals), 0, 6) end

    local row = self:MakeRow(page, 34)
    local label = self:MakeLabel(row, text, 10, 120)
    label.Size = UDim2.new(1, -100, 1, 0)
    label.TextTruncate = Enum.TextTruncate.AtEnd

    local box = self:MakeTextBox(row, "", "", -82, 72)
    box.TextXAlignment = Enum.TextXAlignment.Center
    box.Font = Enum.Font.GothamBold
    box.ClearTextOnFocus = true   -- toca e ja digita; vazio = volta pro valor atual

    local function fmt(v)
        if decimals then return string.format("%." .. decimals .. "f", v) end
        local s = string.format("%.6f", v)
        s = s:gsub("0+$", "")
        s = s:gsub("%.$", "")
        return s
    end

    local function rangeHint()
        if minVal and maxVal then return fmt(minVal) .. "~" .. fmt(maxVal) end
        if minVal then return ">=" .. fmt(minVal) end
        if maxVal then return "<=" .. fmt(maxVal) end
        return "valor"
    end

    local function normalize(v)
        if minVal and v < minVal then v = minVal end
        if maxVal and v > maxVal then v = maxVal end
        if decimals then
            local m = 10 ^ decimals
            v = math.floor(v * m + 0.5) / m
            if minVal and v < minVal then v = minVal end
            if maxVal and v > maxVal then v = maxVal end
        end
        return v
    end

    local function parse(raw)
        local t = tostring(raw or "")
        t = t:gsub("%s", "")
        t = t:gsub(",", ".")
        local n = tonumber(t)
        if n == nil or n ~= n or n == math.huge or n == -math.huge then return nil end
        return n
    end

    local current = normalize(tonumber(default) or minVal or 0)

    local function setValue(v, fire)
        local n = tonumber(v)
        if n == nil or n ~= n then n = current end
        n = normalize(n)
        current = n
        box.Text = fmt(n)
        if fire and callback then callback(n) end
        return n
    end

    box.PlaceholderText = rangeHint()
    box.Text = fmt(current)

    box.FocusLost:Connect(function()
        local n = parse(box.Text)
        if n == nil then
            box.Text = fmt(current)
            return
        end
        n = normalize(n)
        setValue(n, n ~= current)
    end)

    self:RegisterFlag(flag or (page.Name .. ":" .. text),
        function() return current end,
        function(v) setValue(v, true) end
    )

    local api = { Frame = row, Box = box, Label = label }
    function api.GetValue() return current end
    function api.SetValue(v, fire) return setValue(v, fire) end
    api.Get = api.GetValue
    api.Set = api.SetValue
    -- muda o minimo/maximo (nil remove o limite); reaplica o valor atual
    function api.SetRange(newMin, newMax, fire)
        minVal = tonumber(newMin)
        maxVal = tonumber(newMax)
        box.PlaceholderText = rangeHint()
        local old = current
        setValue(current, false)
        if fire and callback and current ~= old then callback(current) end
    end
    return api
end
