-- Troca o icone de uma aba depois de criada.
-- tabRef: a page retornada por CreateTab, ou o nome da aba. icon: nome Lucide, rbxassetid, numero ou nil.
function MitHubLib:SetTabIcon(tabRef, icon)
    for _, t in ipairs(self.Tabs) do
        if t.Page == tabRef or t.Page.Name == tabRef then
            local has = ApplyIcon(t.Icon, icon)
            t.Icon.Visible = has
            t.Label.Size = UDim2.new(1, has and -32 or -14, 1, 0)
            t.Label.Position = UDim2.new(0, has and 32 or 12, 0, 0)
            if self._currentTab then self:_SelectTab(self._currentTab) end
            return true
        end
    end
    return false
end

