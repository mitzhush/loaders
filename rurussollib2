function MitHubLib:_BuildAssetSection(page, kind, sectionTitle, ddLabel, idPlaceholder)
    local isSound = kind == "sound"
    local dd, idBox, nameBox, statusLbl

    local function status(msg)
        if statusLbl then statusLbl.Text = msg end
    end
    local function idText(id)
        return (tostring(id or ""):gsub("^rbxassetid://", ""))
    end
    local function refreshDD(selectName)
        dd.SetOptions(self:_AssetOptions(kind))
        dd.Set(selectName or self:_AssetSelected(kind), false)
    end
    local function fillBoxes()
        local sel = self:_AssetSelected(kind)
        local e = self:_AssetFind(kind, sel)
        nameBox.Text = e and e.name or ""
        idBox.Text = idText(self:_AssetResolve(kind))
    end

    self:MakeSeparator(page, sectionTitle)

    dd = self:AddDropdown(page, ddLabel, self:_AssetOptions(kind), self:_AssetSelected(kind), function(name)
        local applied = self:SetAsset(kind, name)
        fillBoxes()
        if isSound then PlayClickSound() end
        status("Selected: " .. applied)
    end, false, true)

    local idRow = self:MakeRow(page, 34)
    self:MakeLabel(idRow, "ID", 10, 50)
    idBox = self:MakeTextBox(idRow, "", idPlaceholder, 0, 0)
    idBox.Size = UDim2.new(1, -74, 0, 22)
    idBox.Position = UDim2.new(0, 64, 0.5, -11)

    local nameRow = self:MakeRow(page, 34)
    self:MakeLabel(nameRow, "Name", 10, 50)
    nameBox = self:MakeTextBox(nameRow, "", "name to save", 0, 0)
    nameBox.Size = UDim2.new(1, -74, 0, 22)
    nameBox.Position = UDim2.new(0, 64, 0.5, -11)

    local buttons = {
        { "Use ID", function()
            local ok, res = self:UseAssetId(kind, idBox.Text)
            if not ok then status(res) return end
            refreshDD(CUSTOM_NAME)
            nameBox.Text = ""
            if isSound then PlayClickSound() end
            status("Using custom ID (not saved)")
        end },
        { "Save", function()
            local ok, res = self:SaveAssetId(kind, nameBox.Text, idBox.Text)
            if not ok then status(res) return end
            nameBox.Text = res
            refreshDD(res)
            if isSound then PlayClickSound() end
            status("Saved: " .. res)
        end },
        { "Delete", function()
            local cur = dd.Get()
            if cur == ORIGINAL_NAME then status("Original MitHub can't be deleted") return end
            if not cur or not self:_AssetFind(kind, cur) then status("Select a saved item first") return end
            self:DeleteAsset(kind, cur)
            refreshDD()
            fillBoxes()
            status("Deleted: " .. cur)
        end },
    }
    if isSound then
        table.insert(buttons, { "Test", function() end })
    end
    self:AddButtonRow(page, buttons)

    local _, lbl = self:MakeSeparator(page, "")
    statusLbl = lbl

    fillBoxes()
end

