function MitHubLib:_ComputeAccent(color)
    local C = self.COLORS
    local lum = 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
    local on = lum > 0.55 and Color3.fromRGB(10, 10, 10) or Color3.fromRGB(245, 245, 245)
    C.THEME = color
    C.TAB_SELECTED = color
    C.TAB_TEXT_SELECTED = on
    C.DOT_ON = on
end

function MitHubLib:_ApplyTheme()
    local C = self.COLORS
    for inst, props in pairs(self._themed) do
        if inst.Parent then
            for prop, role in pairs(props) do
                pcall(function() inst[prop] = C[role] end)
            end
        else
            self._themed[inst] = nil
        end
    end
    for sw, info in pairs(self._switches) do
        if sw.Parent then
            pcall(function()
                sw.BackgroundColor3 = info.state and C.THEME or C.SWITCH_OFF
                info.Dot.BackgroundColor3 = info.state and C.DOT_ON or C.DOT_OFF
            end)
        else
            self._switches[sw] = nil
        end
    end
    if self._currentTab then pcall(function() self:_SelectTab(self._currentTab) end) end
    for _, fn in ipairs(self._themeHooks) do pcall(fn) end
end

function MitHubLib:OnTheme(fn)
    self:_OnTheme(fn)
    pcall(fn)
end

function MitHubLib:Themed(inst, prop, role)
    local lib = ActiveLib
    if not lib or not lib._themed then return inst end
    Th(inst, prop, role)
    pcall(function() inst[prop] = lib.COLORS[role] end)
    return inst
end

function MitHubLib:SetAccent(color, save)
    self:_ComputeAccent(color)
    self:_ApplyTheme()
    if save then
        self.Settings.accent = {
            math.round(color.R * 255), math.round(color.G * 255), math.round(color.B * 255),
        }
        self._accentToken = (self._accentToken or 0) + 1
        local token = self._accentToken
        task.delay(0.5, function()
            if token == self._accentToken then self:SaveSettings() end
        end)
    end
end

function MitHubLib:_StyleText(obj)
    if not (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then return end
    local role = self._fontRoles[obj]
    if not role then
        role = FontRole(obj.Font)
        self._fontRoles[obj] = role
    end
    obj.Font = self._fontFamily[role]
end

function MitHubLib:_ApplyFontAll()
    for _, d in ipairs(self.ScreenGui:GetDescendants()) do
        self:_StyleText(d)
    end
end

function MitHubLib:SetFont(name, save)
    local fam = FONT_LOOKUP[name]
    if not fam then return false end
    self._fontName = name
    self._fontFamily = fam
    self:_ApplyFontAll()
    if save then
        self.Settings.font = name
        self:SaveSettings()
    end
    return true
end

function MitHubLib:GetFonts()
    local list = {}
    for i, n in ipairs(FONT_LIST) do list[i] = n end
    return list
end

function MitHubLib:ResetAppearance()
    local C = self.COLORS
    for k, v in pairs(self._defaultAccent) do C[k] = v end
    self.Settings.accent = nil
    self:_ApplyTheme()
    if self.AccentPicker then self.AccentPicker.SetColor(C.THEME) end
    self:SetFont("Gotham", true)
    if self.FontDropdown then self.FontDropdown.Set("Gotham", false) end
    self:SaveSettings()
end

