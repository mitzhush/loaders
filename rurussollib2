    Stroke(Btn, "THEME", 1, 0.5)

    local function fire()
        TweenService:Create(Btn, TweenInfo.new(0.1), { BackgroundTransparency = 0 }):Play()
        task.delay(0.15, function()
            TweenService:Create(Btn, TweenInfo.new(0.1), { BackgroundTransparency = 0.2 }):Play()
        end)
        if callback then callback() end
    end

    Btn.MouseButton1Click:Connect(function()
        PlayClickSound()
        fire()
    end)

    local keyCtl
    local function addKeybind(default)
        if default == true then default = nil end
        if keyCtl then
            if default ~= nil then keyCtl.SetKey(default) end
            return keyCtl
        end
        keyCtl = self:_AttachKeybind(Btn, -44, 38, fire,
            (flag or (page.Name .. ":" .. text)) .. ":key", default)
        keyCtl.Button.Position = UDim2.new(1, -44, 0.5, -10)
        if not self.IsMobile then
            local pad = Instance.new("UIPadding", Btn)
            pad.PaddingLeft = UDim.new(0, 48)
            pad.PaddingRight = UDim.new(0, 48)
        end
        return keyCtl
    end

    if keybind then addKeybind(keybind) end

    return Btn, {
        AddKeybind = addKeybind,
        GetKey = function() return keyCtl and keyCtl.GetKey() or nil end,
        SetKey = function(k) if keyCtl then keyCtl.SetKey(k) end end,
    }
end

