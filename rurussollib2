    valueLbl.TextTruncate = Enum.TextTruncate.AtEnd

    local arrow = Instance.new("TextLabel", row)
    arrow.Size = UDim2.new(0, 16, 0, 16)
    arrow.Position = UDim2.new(1, -26, 0, 9)
    arrow.BackgroundTransparency = 1
    arrow.Text = ">"
    arrow.Font = Enum.Font.GothamBold
    arrow.TextColor3 = C.TEXT_DIM
    arrow.TextSize = 12

    local header = Instance.new("TextButton", row)
    header.Size = UDim2.new(1, 0, 0, 34)
    header.BackgroundTransparency = 1
    header.Text = ""
    header.AutoButtonColor = false

    local listFrame = Instance.new("ScrollingFrame", row)
    listFrame.Position = UDim2.new(0, 6, 0, 40)
    listFrame.Size = UDim2.new(1, -12, 0, 0)
    listFrame.BackgroundTransparency = 1
    listFrame.BorderSizePixel = 0
    listFrame.ScrollBarThickness = 2
    listFrame.ScrollBarImageColor3 = C.THEME
    Th(listFrame, "ScrollBarImageColor3", "THEME")
    listFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    listFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
    local layout = Instance.new("UIListLayout", listFrame)
    layout.Padding = UDim.new(0, GAP)
    layout.SortOrder = Enum.SortOrder.LayoutOrder

    local selected = nil
    local chosen = {}
    local items = {}
    local isOpen = false
    local flashToken = 0
    local setOpen

    local function isOption(v)
        for _, o in ipairs(opts) do
            if o == v then return true end
        end
        return false
    end

    local function countChosen()
        local n = 0
        for _ in pairs(chosen) do n = n + 1 end
        return n
    end

    local function getList()
        local list = {}
        for _, o in ipairs(opts) do
            if chosen[o] then table.insert(list, o) end
        end
        return list
    end

    local function listHeight()
        local n = math.min(#opts, MAX_VISIBLE)
        if n == 0 then return 0 end
        return n * ITEM_H + (n - 1) * GAP
    end

    local function refreshValue()
        local txt
        if multi then
            local list = getList()
            txt = #list == 0 and "None" or table.concat(list, ", ")
            if maxSel then txt = string.format("%d/%d  %s", #list, maxSel, txt) end
        else
            txt = selected or "None"
        end
        valueLbl.Text = txt
        valueLbl.TextColor3 = C.TEXT_DIM
    end

    local function styleItem(name)
        local it = items[name]
        if not it then return end
        local on
        if multi then on = chosen[name] and true or false else on = selected == name end
        it.Btn.BackgroundColor3 = on and C.TAB_SELECTED or C.THEME_DARK
        it.Txt.TextColor3 = on and C.TAB_TEXT_SELECTED or C.TEXT
        if it.Chk then
            it.Chk.BackgroundColor3 = C.TAB_TEXT_SELECTED
            it.Chk.BackgroundTransparency = on and 0 or 1
            it.ChkStroke.Color = on and C.TAB_TEXT_SELECTED or C.TEXT_DIM
        end
    end

    local function refreshAll()
        for name in pairs(items) do styleItem(name) end
        refreshValue()
    end

    local function flashLimit()
        flashToken = flashToken + 1
        local t = flashToken
        valueLbl.Text = "Limit: " .. tostring(maxSel)
        valueLbl.TextColor3 = Color3.fromRGB(255, 90, 90)
        task.delay(0.9, function()
            if t == flashToken then refreshValue() end
        end)
    end

    local function buildItems()
        for _, it in pairs(items) do it.Btn:Destroy() end
        items = {}
        for i, name in ipairs(opts) do
            local b = Instance.new("TextButton", listFrame)
            b.Name = name
            b.LayoutOrder = i
            b.Size = UDim2.new(1, -4, 0, ITEM_H)
            b.BackgroundTransparency = 0.2
            b.AutoButtonColor = false
            b.Text = ""
            Corner(b, 5)

            local t = Instance.new("TextLabel", b)
            t.Size = UDim2.new(1, multi and -34 or -20, 1, 0)
            t.Position = UDim2.new(0, 10, 0, 0)
            t.BackgroundTransparency = 1
            t.Text = name
            t.Font = Enum.Font.GothamSemibold
            t.TextSize = 11
            t.TextXAlignment = Enum.TextXAlignment.Left
            t.TextTruncate = Enum.TextTruncate.AtEnd

            local it = { Btn = b, Txt = t }
            if multi then
                local chk = Instance.new("Frame", b)
                chk.Size = UDim2.new(0, 12, 0, 12)
                chk.AnchorPoint = Vector2.new(1, 0.5)
                chk.Position = UDim2.new(1, -10, 0.5, 0)
                chk.BorderSizePixel = 0
                Corner(chk, 3)
                it.Chk = chk
                it.ChkStroke = Stroke(chk, C.TEXT_DIM, 1, 0)
            end
            items[name] = it

            b.MouseButton1Click:Connect(function()
                PlayClickSound()
                if multi then
                    if chosen[name] then
                        chosen[name] = nil
                    else
                        if maxSel and countChosen() >= maxSel then
                            flashLimit()
                            return
                        end
                        chosen[name] = true
                    end
                    refreshAll()
                    if callback then callback(getList()) end
                else
                    if selected == name and not cfg.noDeselect then
                        selected = nil
                    else
                        selected = name
                    end
                    refreshAll()
                    setOpen(false)
                    if callback then callback(selected) end
                end
            end)
        end
        refreshAll()
    end

    setOpen = function(v)
        if v and #opts == 0 then return end
        isOpen = v
        local lh = listHeight()
        listFrame.Size = UDim2.new(1, -12, 0, lh)
        TweenService:Create(row, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(1, -8, 0, v and (34 + 6 + lh + 6) or 34),
        }):Play()
        TweenService:Create(arrow, TweenInfo.new(0.2), { Rotation = v and 90 or 0 }):Play()
    end

    header.MouseButton1Click:Connect(function()
        PlayClickSound()
        setOpen(not isOpen)
    end)

    local function setSingle(v, fire)
        local prev = selected
        if v ~= nil and v ~= false then
            v = tostring(v)
            if not isOption(v) then v = nil end
        else
            v = nil
        end
        selected = v
        refreshAll()
        if fire and callback then
            if v ~= nil then
                callback(v)
            elseif prev ~= nil then
                callback(nil)
            end
        end
    end

    local function setMulti(list, fire)
        chosen = {}
        local n = 0
        if type(list) == "table" then
            for _, v in ipairs(list) do
                v = tostring(v)
                if isOption(v) and not chosen[v] and (not maxSel or n < maxSel) then
                    chosen[v] = true
                    n = n + 1
                end
            end
        end
        refreshAll()
        if fire and callback then callback(getList()) end
    end

    buildItems()
    if multi then setMulti(cfg.default, false) else setSingle(cfg.default, false) end

    self:_OnTheme(refreshAll)

    local api = { Frame = row }

    if multi then
        function api.Get() return getList() end
        function api.Set(list, fire) setMulti(list, fire) end
    else
        function api.Get() return selected end
        function api.Set(v, fire) setSingle(v, fire) end
    end

    function api.SetOptions(newOpts)
        opts = {}
        for _, o in ipairs(newOpts or {}) do table.insert(opts, tostring(o)) end
        if multi then
            for k in pairs(chosen) do
                if not isOption(k) then chosen[k] = nil end
            end
        elseif selected and not isOption(selected) then
            selected = nil
        end
        buildItems()
        if isOpen then setOpen(true) end
    end

    function api.Open() setOpen(true) end
    function api.Close() setOpen(false) end

    if cfg.flag ~= false then
        self:RegisterFlag(cfg.flag or (page.Name .. ":" .. text),
            function()
                local v = api.Get()
                if not multi and v == nil then return false end
                return v
            end,
            function(v)
                if multi then
                    if type(v) == "table" then setMulti(v, true) end
                else
                    setSingle(v, true)
                end
            end
        )
    end

    return api
end

