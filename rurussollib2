local function ReadJson(path)
    if not FS_OK then return nil end
    local ok, data = pcall(function()
        if isfile(path) then
            return HttpService:JSONDecode(readfile(path))
        end
    end)
    if ok then return data end
    return nil
end

local function WriteJson(path, data)
    if not FS_OK then return false end
    local ok = pcall(function()
        writefile(path, HttpService:JSONEncode(data))
    end)
    return ok
end

local function CleanName(name)
    local n = tostring(name or "")
    n = n:gsub("[^%w%s_%-]", "")
    n = n:gsub("^%s+", "")
    n = n:gsub("%s+$", "")
    return n:sub(1, 32)
end

local function BindDrag(handle, onStart, onMove, onEnd)
    local active = false
    local origin
    local touch
    handle.InputBegan:Connect(function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
            active = true
            origin = input.Position
            touch = t == Enum.UserInputType.Touch and input or nil
            onStart()
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not active then return end
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseMovement or (touch and input == touch) then
            local d = input.Position - origin
            onMove(Vector2.new(d.X, d.Y))
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if not active then return end
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1 or (touch and input == touch) then
            active = false
            if onEnd then onEnd() end
        end
    end)
end

local LucideModule
local LucideTried = false
local LucideCache = {}

local function LoadLucide()
    if LucideModule then return LucideModule end
    if LucideTried then return nil end
    LucideTried = true

    local fromCache = false
    local ok, mod = pcall(function()
        local src
        if FS_OK then
            EnsureFolders()
            if not isfolder(LUCIDE_DIR) then makefolder(LUCIDE_DIR) end
            if isfile(LUCIDE_FILE) then
                src = readfile(LUCIDE_FILE)
                fromCache = true
            end
        end
        if not src then
            src = game:HttpGet(LUCIDE_URL)
            -- manda tudo (eu esperokk)
            src = src:gsub("lucide%-icons", LUCIDE_DIR)
            if FS_OK then pcall(writefile, LUCIDE_FILE, src) end
        end
        return loadstring(src)()
    end)

    if ok and type(mod) == "table" and type(mod.GetAsset) == "function" then
        LucideModule = mod
    else
        warn("[MitHubLib] Lucide nao carregou:", mod)
        -- cache possivelmente corrompido: apaga pra baixar de novo na proxima
        if fromCache and FS_OK then pcall(delfile, LUCIDE_FILE) end
    end
    return LucideModule
end

-- icon aceita: nil/"" | numero | "rbxassetid://123" | "123" | "lucide:house" | "house"
-- retorna: image, rectOffset, rectSize  (rect so existe pros icones lucide)
local function ResolveIcon(icon)
    if icon == nil or icon == false or icon == "" then return nil end
    if type(icon) == "number" then return "rbxassetid://" .. math.floor(icon) end
    if type(icon) ~= "string" then return nil end

    local s = (icon:gsub("^%s+", "")):gsub("%s+$", "")
    if s == "" then return nil end

    if s:match("^rbxassetid://") or s:match("^rbxasset://") or s:match("^https?://") or s:match("^%d+$") then
        return NormalizeAssetId(s) or s
    end

    local name = (s:gsub("^[Ll]ucide:", "")):lower()
    name = name:gsub("[%s_]+", "-")

    local asset = LucideCache[name]
    if asset == nil then
        local mod = LoadLucide()
        local good, res = false, nil
        if mod then good, res = pcall(mod.GetAsset, name) end
        if good and type(res) == "table" and res.Url then
            asset = res
        else
            asset = false
            if mod then warn("[MitHubLib] Icone Lucide nao encontrado: " .. name) end
        end
        LucideCache[name] = asset
    end

    if asset then return asset.Url, asset.ImageRectOffset, asset.ImageRectSize end
    return nil
end

local function ApplyIcon(img, icon)
    local image, off, size = ResolveIcon(icon)
    if not image then
        img.Image = ""
        img.ImageRectOffset = Vector2.new(0, 0)
        img.ImageRectSize = Vector2.new(0, 0)
        return false
    end
    img.Image = image
    img.ImageRectOffset = off or Vector2.new(0, 0)
    img.ImageRectSize = size or Vector2.new(0, 0)
    return true
end

