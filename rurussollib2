    pl.FillDirection = Enum.FillDirection.Horizontal
    pl.Padding = UDim.new(0, 3)
    pl.SortOrder = Enum.SortOrder.LayoutOrder

    local H, S, V = 0, 0, 1
    local oldColor = Color3.new(1, 1, 1)

    local function current() return Color3.fromHSV(H, S, V) end

