    card.BorderSizePixel = 0
    card.AutoButtonColor = false
    card.Text = ""
    card.ZIndex = 201
    Corner(card, 8)
    Stroke(card, "THEME", 1.2, 0.35)

    local pad = Instance.new("UIPadding", card)
    pad.PaddingTop = UDim.new(0, 9)
    pad.PaddingBottom = UDim.new(0, 9)
    pad.PaddingLeft = UDim.new(0, 10)
    pad.PaddingRight = UDim.new(0, 10)

    local icon = Instance.new("ImageLabel", card)
    icon.Name = "Icon"
    icon.Size = UDim2.new(0, 16, 0, 16)
    icon.BackgroundTransparency = 1
    icon.Image = NOTIFY_ICON
    icon.ImageColor3 = C.TEXT
    icon.ZIndex = 202

    local label = Instance.new("TextLabel", card)
    label.Name = "Text"
    label.Size = UDim2.new(1, -24, 0, 16)
    label.Position = UDim2.new(0, 24, 0, 0)
    label.AutomaticSize = Enum.AutomaticSize.Y
    label.BackgroundTransparency = 1
    label.Text = text
    label.Font = Enum.Font.GothamSemibold
    label.TextColor3 = C.TEXT
    label.TextSize = 11
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.ZIndex = 202

    local entry = {}
    local closed = false
    local function close()
        if closed then return end
        closed = true
        for i, e in ipairs(self._notifyList) do
            if e == entry then
                table.remove(self._notifyList, i)
                break
            end
        end
        local tw = TweenService:Create(card, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0, 290, 0, 0),
        })
        tw.Completed:Connect(function()
            wrap:Destroy()
        end)
        tw:Play()
    end
    entry.close = close
    table.insert(self._notifyList, entry)

    card.MouseButton1Click:Connect(close)
    TweenService:Create(card, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0, 0, 0, 0),
    }):Play()
    task.delay(duration, close)

    while #self._notifyList > 5 do
        self._notifyList[1].close()
    end
end

