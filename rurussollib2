local ASSET = {
    sound = { list = "sounds", sel = "soundSel", custom = "soundCustom" },
    image = { list = "images", sel = "imageSel", custom = "imageCustom" },
}

function MitHubLib:_AssetList(kind)
    local k = ASSET[kind]
    if type(self.Settings[k.list]) ~= "table" then self.Settings[k.list] = {} end
    return self.Settings[k.list]
end

function MitHubLib:_AssetOriginal(kind)
    return kind == "sound" and ORIGINAL_SOUND or BG_IMAGE
end

function MitHubLib:_AssetFind(kind, name)
    for i, e in ipairs(self:_AssetList(kind)) do
        if type(e) == "table" and e.name == name then return e, i end
    end
    return nil
end

function MitHubLib:_AssetSelected(kind)
    local k = ASSET[kind]
    local sel = self.Settings[k.sel]
    if sel == ORIGINAL_NAME or sel == NONE_NAME then return sel end
    if sel == CUSTOM_NAME and NormalizeAssetId(self.Settings[k.custom]) then return sel end
    if type(sel) == "string" and self:_AssetFind(kind, sel) then return sel end
    return ORIGINAL_NAME
end

function MitHubLib:_AssetResolve(kind)
    local sel = self:_AssetSelected(kind)
    if sel == NONE_NAME then return "" end
    if sel == CUSTOM_NAME then
        return NormalizeAssetId(self.Settings[ASSET[kind].custom]) or self:_AssetOriginal(kind)
    end
    if sel ~= ORIGINAL_NAME then
        local e = self:_AssetFind(kind, sel)
        if e then return NormalizeAssetId(e.id) or self:_AssetOriginal(kind) end
    end
    return self:_AssetOriginal(kind)
end

function MitHubLib:_AssetOptions(kind)
    local opts = { ORIGINAL_NAME, NONE_NAME }
    for _, e in ipairs(self:_AssetList(kind)) do
        if type(e) == "table" and type(e.name) == "string" then table.insert(opts, e.name) end
    end
    if self:_AssetSelected(kind) == CUSTOM_NAME then table.insert(opts, CUSTOM_NAME) end
    return opts
end

function MitHubLib:_AssetApply(kind)
    local id = self:_AssetResolve(kind)
    if kind == "sound" then
        self._clickSoundId = id
    elseif self.BgImage then
        self.BgImage.Image = id
    end
    return id
end

function MitHubLib:SetAsset(kind, name)
    self.Settings[ASSET[kind].sel] = name
    local applied = self:_AssetSelected(kind)
    self.Settings[ASSET[kind].sel] = applied
    self:_AssetApply(kind)
    self:SaveSettings()
    return applied
end

function MitHubLib:UseAssetId(kind, raw)
    local id = NormalizeAssetId(raw)
    if not id then return false, "Invalid ID (use only numbers)" end
    self.Settings[ASSET[kind].custom] = id
    self.Settings[ASSET[kind].sel] = CUSTOM_NAME
    self:_AssetApply(kind)
    self:SaveSettings()
    return true, CUSTOM_NAME
end

function MitHubLib:SaveAssetId(kind, name, raw)
    local id = NormalizeAssetId(raw)
    if not id then return false, "Invalid ID (use only numbers)" end
    name = CleanName(name)
    if name == "" then return false, "Type a name first" end
    local low = name:lower()
    if low == ORIGINAL_NAME:lower() or low == NONE_NAME:lower() or low == CUSTOM_NAME:lower() then
        return false, "That name is reserved"
    end
    local e = self:_AssetFind(kind, name)
    if e then
        e.id = id
    else
        table.insert(self:_AssetList(kind), { name = name, id = id })
    end
    self.Settings[ASSET[kind].sel] = name
    self:_AssetApply(kind)
    self:SaveSettings()
    return true, name
end

function MitHubLib:DeleteAsset(kind, name)
    local e, i = self:_AssetFind(kind, name)
    if not e then return false end
    table.remove(self:_AssetList(kind), i)
    if self.Settings[ASSET[kind].sel] == name then
        self.Settings[ASSET[kind].sel] = ORIGINAL_NAME
    end
    self:_AssetApply(kind)
    self:SaveSettings()
    return true
end

function MitHubLib:SetClickSound(name) return self:SetAsset("sound", name) end
function MitHubLib:SetClickSoundId(id) return self:UseAssetId("sound", id) end
function MitHubLib:SetBackgroundImage(name) return self:SetAsset("image", name) end
