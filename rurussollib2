function MitHubLib:_StartCapture(onKey, onCancel)
    if self._captureCancel then
        local cancel = self._captureCancel
        self._captureCancel = nil
        cancel()
    end
    self._captureCancel = onCancel
    self._capture = function(key)
        self._captureCancel = nil
        onKey(key)
    end
end

function MitHubLib:_AttachKeybind(parent, xOff, width, onFire, flagKey, defaultKey)
    local btn = self:MakeKeybindBtn(parent, "---", xOff)
    btn.Size = UDim2.new(0, width, 0, 20)
    btn.TextTruncate = Enum.TextTruncate.AtEnd
    btn.Visible = not self.IsMobile

    local bound
    local binding = false
    local justBound = false

    local function refresh()
        btn.Text = binding and "..." or KeyLabel(bound and bound.Name)
        btn.TextColor3 = (bound or binding) and self.COLORS.TEXT or self.COLORS.TEXT_DIM
    end

    local function setKey(key)
        if type(key) == "string" then
            if key == "" then
                key = nil
            else
                local ok, k = pcall(function() return Enum.KeyCode[key] end)
                key = ok and k or nil
            end
        elseif typeof(key) ~= "EnumItem" then
            key = nil
        end
        if key == Enum.KeyCode.Unknown then key = nil end
        bound = key
        binding = false
        refresh()
    end

    btn.MouseButton1Click:Connect(function()
        PlayClickSound()
        binding = true
        refresh()
        self:_StartCapture(function(key)
            justBound = true
            task.defer(function() justBound = false end)
            binding = false
            if key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Delete then
                bound = nil
            elseif key ~= Enum.KeyCode.Escape and key ~= Enum.KeyCode.Unknown then
                bound = key
            end
            refresh()
        end, function()
            binding = false
            refresh()
        end)
    end)

    self:_Connect(UserInputService.InputBegan, function(input, processed)
        if processed or binding or justBound then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if bound and input.KeyCode == bound then onFire() end
    end)

    if flagKey then
        self:RegisterFlag(flagKey,
            function() return bound and bound.Name or "" end,
            function(v) setKey(v) end
        )
    end

    setKey(defaultKey)

    return {
        Button = btn,
        GetKey = function() return bound end,
        SetKey = function(k) setKey(k) end,
    }
end

