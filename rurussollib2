        if not hexBox:IsFocused() then hexBox.Text = ToHex(c) end
        rgbLbl.Text = string.format("R %d    G %d    B %d",
            math.round(c.R * 255), math.round(c.G * 255), math.round(c.B * 255))
    end

    local function emit()
        render()
        if P.onChange then P.onChange(current()) end
    end

    local function setFrom(c, fire)
        H, S, V = c:ToHSV()
        if fire then emit() else render() end
    end

    for i, pc in ipairs(PRESET_COLORS) do
        local b = Instance.new("TextButton", presetRow)
        b.LayoutOrder = i
        b.Size = UDim2.new(0, 18, 0, 18)
        b.BackgroundColor3 = pc
        b.BorderSizePixel = 0
        b.AutoButtonColor = false
        b.Text = ""
        Corner(b, 4)
        Stroke(b, BLACK, 1, 0)
        b.MouseButton1Click:Connect(function()
            PlayClickSound()
            setFrom(pc, true)
        end)
    end

    oldSw.MouseButton1Click:Connect(function()
        PlayClickSound()
        setFrom(oldColor, true)
    end)

    hexBox.FocusLost:Connect(function()
        local c = FromHex(hexBox.Text)
        if c then setFrom(c, true) else render() end
    end)

    local dragSV, dragHue = false, false
    local function isPress(t)
        return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
    end
    local function updSV(pos)
        local ap, as = sv.AbsolutePosition, sv.AbsoluteSize
        S = math.clamp((pos.X - ap.X) / as.X, 0, 1)
        V = 1 - math.clamp((pos.Y - ap.Y) / as.Y, 0, 1)
        emit()
    end
    local function updHue(pos)
        local ap, as = hue.AbsolutePosition, hue.AbsoluteSize
        H = math.clamp((pos.X - ap.X) / as.X, 0, 1)
        emit()
    end
    svHit.InputBegan:Connect(function(input)
        if isPress(input.UserInputType) then
            dragSV = true
            updSV(input.Position)
        end
    end)
    hueHit.InputBegan:Connect(function(input)
        if isPress(input.UserInputType) then
            dragHue = true
            updHue(input.Position)
        end
    end)
    self:_Connect(UserInputService.InputChanged, function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch then
            if dragSV then updSV(input.Position)
            elseif dragHue then updHue(input.Position) end
        end
    end)
    self:_Connect(UserInputService.InputEnded, function(input)
        if isPress(input.UserInputType) then
            dragSV, dragHue = false, false
        end
    end)

    blocker.MouseButton1Click:Connect(function()
        self:_ClosePicker()
    end)

    function P.Set(c) setFrom(c, false) end

    function P.Open(anchor, color, onChange, owner)
        P.onChange = nil
        P.owner = owner
        oldColor = color
        oldSw.BackgroundColor3 = color
        setFrom(color, false)
        P.onChange = onChange

        local vp = gui.AbsoluteSize
        local mp = self.MainFrame.Position
        local base = Vector2.new(mp.X.Scale * vp.X + mp.X.Offset, mp.Y.Scale * vp.Y + mp.Y.Offset)
        local rel = anchor.AbsolutePosition - self.MainFrame.AbsolutePosition
        local x = base.X + rel.X + anchor.AbsoluteSize.X - PW
        local y = base.Y + rel.Y + anchor.AbsoluteSize.Y + 6
        if y + PH > vp.Y - 6 then y = base.Y + rel.Y - PH - 6 end
        x = math.clamp(x, 6, math.max(6, vp.X - PW - 6))
        y = math.clamp(y, 6, math.max(6, vp.Y - PH - 6))
        pop.Position = UDim2.new(0, x, 0, y)

        blocker.Visible = true
        pop.Visible = true
    end

    function P.Close()
        pop.Visible = false
        blocker.Visible = false
        P.onChange = nil
        P.owner = nil
        dragSV, dragHue = false, false
    end

    self._picker = P
    return P
end

function MitHubLib:_ClosePicker()
